# SmartClipboard repo ignore rules

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.pyrightcache/
.codegraph/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/

# --- OS / Editor ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.idea/
*.swp
*.swo
*~
*.orig
*.bak

# Local env / secrets
.env
.env.*
!.env.example

# --- App local data (do not version) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.log
*.log.*
debug_startup_error.log

# Agent/session caches (project skills under these dirs stay tracked)
.grok/sessions/
.grok/cache/
.grok/tmp/
.claude/cache/
.claude/plugins/cache/
.claude/settings.local.json
.agents/cache/
.agents/sessions/
.specify/.cache/

# Backups (contains user DB snapshots)
backups/

# --- Build artifacts ---
build/
dist/
dist3/
*.spec.bak
.tmp-unittest/
*.7z

# Bytecode caches that may appear inside build outputs
build/**/localpycs/

# Executables produced by PyInstaller
*.exe

# Keep tracked payload that the app needs at runtime:
!smartclipboard_app/legacy_main_payload.marshal
!smartclipboard_app/legacy_main_payload.manifest.json

# --- Rust & Node (Native Edition) ---
native/node_modules/
native/dist/
native/src-tauri/target/

# Keep test fixtures
!tests/native_parity/fixtures/*.db

